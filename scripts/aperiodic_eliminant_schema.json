{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aperiodic Hankel Eliminant Certificate",
  "type": "object",
  "required": ["schema_version", "row", "agreement_threshold", "removed_ledgers", "exact_agreements"],
  "properties": {
    "schema_version": {"type": "string", "const": "aperiodic-hankel-eliminant-v1"},
    "row": {
      "type": "object",
      "required": ["n", "k", "field", "domain_hash"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 1},
        "field": {"type": "string"},
        "domain_hash": {"type": "string"},
        "domain_description": {"type": "string"}
      }
    },
    "agreement_threshold": {"type": "integer", "minimum": 0},
    "sampler": {"type": "string", "enum": ["finite_affine_line", "projective_line", "finite_power_curve"]},
    "sampler_audit": {
      "type": "object",
      "properties": {
        "sampler": {"type": "string", "enum": ["finite_affine_line", "projective_line", "finite_power_curve"]},
        "slope_field": {"type": "string"},
        "slope_field_order": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1},
        "denominator_formula": {"type": "string"},
        "field_role": {"type": "string"},
        "extension_denominator_warning": {"type": "string"}
      }
    },
    "claim_scope": {
      "type": "object",
      "required": ["row_data", "threshold_role", "root_status", "may_be_used_for_threshold_pinning"],
      "properties": {
        "row_data": {
          "type": "string",
          "enum": ["toy_row", "synthetic_syndrome_pencil", "generic_symbolic", "settled_row_bookkeeping", "actual_row_certificate"]
        },
        "threshold_role": {
          "type": "string",
          "enum": ["none", "format_smoke", "toy_mechanism", "synthetic_stress", "generic_identity", "actual_row_audit", "actual_safe_side_bound", "actual_unsafe_lower_bound", "threshold_pin"]
        },
        "root_status": {
          "type": "string",
          "enum": ["enumerated", "closed_form", "degree_bound_only", "removed_by_ledgers", "not_enumerated", "not_applicable"]
        },
        "may_be_used_for_threshold_pinning": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "curve_degree": {"type": "integer", "minimum": 1},
    "removed_ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "numerator", "certificate_ref"],
        "properties": {
          "name": {"type": "string"},
          "numerator": {"type": "integer", "minimum": 0},
          "certificate_ref": {"type": "string"}
        }
      }
    },
    "exact_agreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["A", "j", "t", "status"],
        "properties": {
          "A": {"type": "integer"},
          "j": {"type": "integer"},
          "t": {"type": "integer"},
          "status": {"type": "string", "enum": ["regular_minor", "pivot_atlas", "empty", "residual_obstruction"]},
          "residual_label": {"type": "string", "enum": ["quotient", "tangent", "extension", "candidate_new_obstruction", "unknown"]},
          "regular_minor": {
            "type": "object",
            "properties": {
              "row_set": {"type": "array", "items": {"type": "integer"}},
              "polynomial_ref": {"type": "string"},
              "degree": {"type": "integer", "minimum": 0},
              "root_hash": {"type": "string"}
            }
          },
          "regular_minor_gcd": {
            "type": "object",
            "properties": {
              "row_sets": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {"type": "integer"}
                }
              },
              "polynomial_ref": {"type": "string"},
              "degree": {"type": "integer", "minimum": 0},
              "root_hash": {"type": "string"},
              "minor_count": {"type": "integer", "minimum": 1},
              "containment": {"type": "string"}
            }
          },
          "regular_minor_data": {
            "type": "object",
            "properties": {
              "root_certificate": {
                "type": "object",
                "properties": {
                  "kind": {"type": "string", "enum": ["split_linear_factorization"]},
                  "leading_coefficient": {"type": "integer", "minimum": 0},
                  "field_encoding": {"type": "string"},
                  "factors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "root": {"type": "integer", "minimum": 0},
                        "multiplicity": {"type": "integer", "minimum": 1}
                      }
                    }
                  }
                }
              }
            }
          },
          "regular_minor_gcd_data": {
            "type": "object"
          },
          "projective_infinity": {
            "type": "object",
            "properties": {
              "projective_point": {"type": "string", "const": "[0:1]"},
              "status": {"type": "string", "enum": ["empty", "nonempty"]},
              "top_degree": {"type": "integer", "minimum": 0},
              "top_coefficient": {"type": "integer", "minimum": 0},
              "field_encoding": {"type": "string"},
              "contribution": {"type": "integer", "minimum": 0},
              "reason": {"type": "string"}
            }
          },
          "charts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chart_id", "equations_ref", "inequations_ref", "pivot_records"],
              "properties": {
                "chart_id": {"type": "string"},
                "equations_ref": {"type": "string"},
                "inequations_ref": {"type": "string"},
                "coverage_ref": {"type": "string"},
                "pivot_records": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["pivot", "status"],
                    "properties": {
                      "pivot": {"type": "string"},
                      "status": {"type": "string", "enum": ["eliminant", "empty", "dimension_degree", "residual_obstruction"]},
                      "eliminant_ref": {"type": "string"},
                      "degree": {"type": "integer", "minimum": 0},
                      "dimension": {"type": "integer", "minimum": 0},
                      "variety_degree": {"type": "integer", "minimum": 0},
                      "residual_label": {"type": "string", "enum": ["quotient", "tangent", "extension", "candidate_new_obstruction", "unknown"]}
                    },
                    "allOf": [
                      {
                        "if": {"properties": {"status": {"const": "eliminant"}}},
                        "then": {"required": ["eliminant_ref", "degree"]}
                      },
                      {
                        "if": {"properties": {"status": {"const": "dimension_degree"}}},
                        "then": {"required": ["dimension", "variety_degree"]}
                      },
                      {
                        "if": {"properties": {"status": {"const": "residual_obstruction"}}},
                        "then": {"required": ["residual_label"]}
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "pivot_atlas"}}},
            "then": {"required": ["charts"]}
          },
          {
            "if": {"properties": {"status": {"const": "residual_obstruction"}}},
            "then": {"required": ["residual_label"]}
          }
        ]
      }
    },
    "declared_aperiodic_numerator": {"type": "integer", "minimum": 0},
    "root_union_table_ref": {"type": "string"}
  }
}

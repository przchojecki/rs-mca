  "budget_decision_table": {
    "combined_bound": {
      "direction_rank": "r = rank H_{t,j}(v)",
      "endpoint_indicator": "e_infty=0 if the infinity chart is empty or paid; e_infty<=1 always by the M5 projective kernel chart",
      "finite_affine_numerator_bound": "B_ap_regular_finite <= r",
      "hypothesis": "nonsingular regular bucket after tangent/common-code-line finite overlap removal",
      "projective_numerator_bound": "B_ap_regular_projective <= r + e_infty"
    },
    "input_theorems": {
      "finite_direction_rank_degree_cap": {
        "certificate_ref": "experimental/data/certificates/hankel-f17-32-m3-direction-rank-degree-cap/f17_32_n512_k256_m3_direction_rank_degree_cap.json",
        "statement": "In a nonsingular regular bucket, if r=rank H_{t,j}(v), then the canonical finite regular root count is at most r."
      },
      "projective_infinity_kernel_chart": {
        "certificate_ref": "experimental/data/certificates/hankel-f17-32-m3-m5-projective-infinity-kernel-chart/f17_32_n512_k256_m3_m5_projective_infinity_kernel_chart.json",
        "statement": "The projective endpoint [0:1] is empty under kernel containment and otherwise contributes at most one projective parameter."
      }
    },
    "rank_cutoffs_for_f17_32_row": {
      "endpoint_sensitive": {
        "condition": "r = 6",
        "finite_upper_bound": 6,
        "projective_upper_bound_before_endpoint_payment": 7,
        "safe_if": "the endpoint is empty/paid or the exact finite root table has at most 5 surviving roots"
      },
      "finite_safe": {
        "condition": "r <= 6",
        "safe_against_finite_sampler": true,
        "upper_bound": 6
      },
      "projective_safe_without_endpoint_payment": {
        "condition": "r <= 5",
        "safe_against_projective_sampler": true,
        "upper_bound": "r + 1 <= 6"
      },
      "root_table_needed": {
        "condition": "r > 6",
        "reason": "the rank cap alone exceeds the 2^-128 numerator budget"
      }
    }
  },
  "checks": [
    "finite and projective 2^-128 budgets both equal 6",
    "dependency windows are both 385..426",
    "dependency row-set totals agree with this certificate",
    "the projective endpoint is counted separately from finite affine roots",
    "rank<=5 is projective-safe without quotient or endpoint subtraction",
    "rank=6 is finite-safe but projective endpoint-sensitive"

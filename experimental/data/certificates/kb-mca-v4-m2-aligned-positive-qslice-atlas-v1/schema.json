{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-mca-v4-m2-aligned-positive-qslice-atlas-v1",
  "title": "KoalaBear aligned-positive q-slice atlas certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent",
    "field",
    "exact_rational_fixtures",
    "scope",
    "registry",
    "source_reconstruction",
    "denominator_and_localizer_policy",
    "classification_order",
    "assignments",
    "cells",
    "literal_symmetries",
    "rejected_globalizations",
    "external_provenance_policy",
    "nonclaims",
    "payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "kb-mca-v4-m2-aligned-positive-qslice-atlas-v1"
    },
    "parent": {
      "type": "object",
      "required": ["commit", "interface", "imported"]
    },
    "field": {
      "type": "object",
      "required": [
        "prime",
        "challenge_extension_degree",
        "symbolic_compiler_field"
      ]
    },
    "exact_rational_fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "b", "c", "d", "w"]
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "branch",
        "assignments",
        "targets_per_assignment",
        "cells",
        "cell_status",
        "ledger_movement"
      ],
      "properties": {
        "assignments": {"const": 12},
        "targets_per_assignment": {"const": 3},
        "cells": {"const": 36},
        "cell_status": {"const": "UNCLASSIFIED_QSLICE_GENERATED"},
        "ledger_movement": {"const": 0}
      }
    },
    "registry": {
      "type": "object",
      "required": ["vertices", "edges", "assignments", "targets"]
    },
    "source_reconstruction": {
      "type": "object",
      "required": [
        "q",
        "q0",
        "q1",
        "F",
        "G",
        "M",
        "V",
        "incidence",
        "internal_target",
        "U_basis",
        "G_source",
        "forced_divisor",
        "projective_target_pivot"
      ]
    },
    "denominator_and_localizer_policy": {
      "type": "object",
      "required": [
        "whole_line_normalization",
        "never_normalize_projective_coefficients_independently",
        "b_nonzero_chart_unit",
        "incidence_D_a_nonzero",
        "reconstruction_determinant_nonzero",
        "all_dropped_factors_require_named_parent_provenance",
        "generic_saturation_used",
        "groebner_search_used"
      ]
    },
    "classification_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "assignments": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "cells": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {"$ref": "#/$defs/cell"}
    },
    "literal_symmetries": {
      "type": "object",
      "required": [
        "star_swap_global_sign",
        "c_d_companion",
        "b_inversion_map",
        "b_inversion_checks",
        "fixed_assignment_quotient_coordinates"
      ]
    },
    "rejected_globalizations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "external_provenance_policy": {
      "type": "object",
      "required": [
        "pins_are_annotations_only",
        "external_scopes_imported",
        "invalid_or_broader_orbit_scopes_imported",
        "pins"
      ]
    },
    "nonclaims": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["degree", "degrees_b_c_d_w", "terms", "sha256"],
      "properties": {
        "degree": {"type": "integer", "minimum": 0},
        "degrees_b_c_d_w": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "integer", "minimum": 0}
        },
        "terms": {"type": "integer", "minimum": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "assignment_id",
        "kind",
        "first_edge",
        "second_edge",
        "common_vertex",
        "first_other_vertex",
        "second_other_vertex",
        "edge_formulas",
        "incidence",
        "reconstruction",
        "assignment_localizer",
        "star_swap",
        "b_inversion_partner"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "assignment_id",
        "target_id",
        "classification",
        "equation_order",
        "equations",
        "line_normalization",
        "cell_localizer",
        "exact_rational_fixture_values",
        "c_d_companion_exact",
        "external_provenance",
        "ledger_movement"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^[FM][0-9]{2}-R(02|11|20)$"
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^[FM][0-9]{2}$"
        },
        "target_id": {"enum": ["R02", "R11", "R20"]},
        "classification": {"const": "UNCLASSIFIED_QSLICE_GENERATED"},
        "equation_order": {
          "const": ["c_constant", "c_linear", "d_constant", "d_linear"]
        },
        "equations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/metric"}
        },
        "line_normalization": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "cell_localizer": {
          "type": "object",
          "required": [
            "radical_factor_count",
            "radical_total_degree",
            "radical_factor_set_sha256",
            "radical_factors",
            "provenance"
          ]
        },
        "exact_rational_fixture_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "c_d_companion_exact": {"const": true},
        "external_provenance": {
          "oneOf": [{"type": "null"}, {"type": "object"}]
        },
        "ledger_movement": {"const": 0}
      }
    }
  }
}

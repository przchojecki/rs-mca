  "identity": {
    "cauchy_binet_formula": "Delta_r(Z)=sum_{S subset X union Y, |S|=r} Vandermonde(S)^2 Z^{|S cap Y|}",
    "compressed_formula": "when H_X is nonsingular, Delta_r(Z)=det(H_X) det(I+Z V_Y^T H_X^{-1} V_Y)",
    "matrix_factorization": "H_r(u)+Z H_r(v)=V_X V_X^T + Z V_Y V_Y^T",
    "root_rule": "if Delta_r is nonzero, finite roots are bounded by degree(Delta_r)<=|Y|; if Delta_r is zero, the bucket is singular and must be passed to the pivot/residual atlas"
  },
  "m3_budget_envelope": {
    "endpoint_conventions": {
      "extra_projective_point": "[0:1]",
      "finite_affine_slope_denominator": 2367911594760467245844106297320951247361,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsmca.xyz/schemas/kb_mca_v4_k3_active_slice_semantic_bridge_route_cut_v1.schema.json",
  "title": "KoalaBear v4 K3 active-slice semantic bridge route cut v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_kind",
    "status",
    "theorem_kind",
    "base_repository",
    "active_contract",
    "definition_inventory",
    "required_compiler",
    "first_failed_bridge",
    "direct_coordinate_countermodel",
    "architecture_comparison",
    "pr_reconciliation",
    "tangent_source_repair",
    "imported_census",
    "exact_ledger_outputs",
    "source_bindings",
    "conclusion",
    "nonclaims",
    "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "rs-mca-kb-v4-k3-active-slice-semantic-bridge-route-cut-v1"},
    "artifact_kind": {"const": "SOURCE_BOUND_DEFINITION_ROUTE_CUT_AND_DIRECT_COORDINATE_COUNTERMODEL"},
    "status": {"const": "PROVED_DEFINITION_LEVEL_ROUTE_CUT_OPEN_GAP"},
    "theorem_kind": {"const": "DIRECT_ENDPOINT_COORDINATE_CARRIER_INFERENCE_COUNTERMODEL"},
    "base_repository": {"type": "object"},
    "active_contract": {"type": "object"},
    "definition_inventory": {"type": "array", "minItems": 5},
    "required_compiler": {"type": "object"},
    "first_failed_bridge": {"type": "object"},
    "direct_coordinate_countermodel": {"type": "object"},
    "architecture_comparison": {"type": "object"},
    "pr_reconciliation": {"type": "array", "minItems": 8, "maxItems": 8},
    "tangent_source_repair": {"type": "object"},
    "imported_census": {"type": "object"},
    "exact_ledger_outputs": {"type": "object"},
    "source_bindings": {"type": "array", "minItems": 10},
    "conclusion": {"type": "object"},
    "nonclaims": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 18,
      "uniqueItems": true
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

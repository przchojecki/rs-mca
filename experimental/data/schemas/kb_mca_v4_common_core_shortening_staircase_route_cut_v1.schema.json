{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rs-mca-kb-v4-common-core-shortening-staircase-route-cut-v1",
  "title": "KoalaBear v4 common-core shortening staircase route cut",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_kind",
    "base",
    "row",
    "theorem",
    "exact_boundaries",
    "terminals",
    "chronology",
    "source_bindings",
    "packet_files",
    "packet_file_sha256",
    "payload_sha256"

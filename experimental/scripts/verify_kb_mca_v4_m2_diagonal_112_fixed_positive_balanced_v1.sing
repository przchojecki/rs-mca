// Independent exact checks for the balanced fixed-positive deletion.
//
// This replay checks the omitted-incidence repair directly after d=w^2/c,
// and independently checks the symmetric support consequences.  It uses
// finite named localizers only; no generic saturation is invoked.

option(redSB);

// Missing ordinary component cd=w^2.
ring r=2130706433,(t,b,c,w),dp;
poly c2=c^2; poly c3=c^3; poly c4=c^4;
poly w2=w^2; poly w3=w^3; poly w4=w^4; poly w5=w^5;
poly qc=
  4*b*c2*w5-10*b*c3*w3+8*b*c2*w4-2*c2*w5+4*b*c4*w
  -14*b*c3*w2+12*b*c2*w3+5*c3*w3-24*b*c*w4+26*c2*w4
  -4*b*w5-4*b*c4-24*b*c3*w-2*c4*w+12*b*c2*w2-17*c3*w2
  -14*b*c*w3+24*c2*w3+4*b*w4-12*c*w4+2*w5+2*c4
  +8*b*c2*w-12*c3*w-10*b*c*w2+24*c2*w2-17*c*w3-2*w4
  +4*b*c2+26*c2*w+5*c*w2-2*c2;
poly qd=
  4*b*c2*w5+8*b*c2*w4-10*b*c*w5-2*c2*w5-4*b*c4*w
  -24*b*c3*w2+12*b*c2*w3-14*b*c*w4+26*c2*w4+4*b*w5
  +5*c*w5+4*b*c4-14*b*c3*w+2*c4*w+12*b*c2*w2-12*c3*w2
  -24*b*c*w3+24*c2*w3-4*b*w4-17*c*w4-2*w5-10*b*c3
  -2*c4+8*b*c2*w-17*c3*w+24*c2*w2-12*c*w3+2*w4
  +4*b*c2+5*c3+26*c2*w-2*c2;
poly ell=
  2*c2*w5-5*c3*w3+4*c2*w4+2*c4*w-7*c3*w2+6*c2*w3
  -12*c*w4-2*w5-2*c4-12*c3*w+6*c2*w2-7*c*w3+2*w4
  +4*c2*w-5*c*w2+2*c2;
poly e1=
  4*c*w3-c*w2-2*c2*w-2*w3+2*c2+2*w2+c*w-4*c;
poly e2=
  c*w3-4*c*w2-2*c2*w-2*w3+2*c2+2*w2+4*c*w-c;
poly arec=5*c*w2-4*c2-4*w2+5*c;
poly hmiss=
  b*c*w*e1*e2*(b-1)*(b+1)*(c-1)*(c+1)
  *(w2-c)*(w2+c)*(w-1)*(w+1)*arec*(w2-1)
  *(b-2)*(2*b-1)*(c2-w2)
  *(c-2)*(2*c-1)*(w2-2*c)*(2*w2-c)*ell;
ideal Imiss=qc,qd,t*hmiss-1;
ideal Gmiss=std(Imiss);
if (size(Gmiss)!=1 || Gmiss[1]!=1)
{
  print("INCIDENCE_CD_EQ_W2_FAIL");
  exit(1);
}
print("INCIDENCE_CD_EQ_W2_PASS");

// Symmetric retained q-essential component.
ring sring=2130706433,(t,s,p,w),dp;
poly s2=s^2; poly s3=s^3; poly s4=s^4; poly s5=s^5;
poly p2=p^2; poly p3=p^3; poly p4=p^4; poly p5=p^5; poly p6=p^6;
poly w2=w^2; poly w3=w^3; poly w4=w^4;
poly Q=
  25*s2*p3*w2-40*s*p4*w2+16*p5*w2-16*s4*p2+40*s3*p3
  -25*s2*p4-32*s4*p*w+80*s3*p2*w-80*s*p4*w+32*p5*w
  -16*s4*w2+40*s3*p*w2-75*s2*p2*w2+40*s*p3*w2
  +40*s3*p2+39*s2*p3-200*s*p4+116*p5+80*s3*p*w
  -72*s2*p2*w-240*s*p3*w+200*p4*w+40*s3*w2+39*s2*p*w2
  -120*s*p2*w2+68*p3*w2-75*s2*p2-120*s*p3+200*p4
  -240*s*p2*w+336*p3*w-25*s2*w2-200*s*p*w2+200*p2*w2
  +25*s2*p+40*s*p2+68*p3-80*s*p*w+200*p2*w+116*p*w2
  -40*s*p+32*p*w+16*p;
poly A=
  -8*s5*p*w3+28*s4*p2*w3-30*s3*p3*w3+13*s2*p4*w3
  -2*s*p5*w3-8*s5*w4+8*s4*p*w4-14*s3*p2*w4+28*s2*p3*w4
  -19*s*p4*w4+4*p5*w4+24*s5*p*w2-72*s4*p2*w2
  +90*s3*p3*w2-48*s2*p4*w2+9*s*p5*w2+24*s5*w3
  -36*s4*p*w3-26*s3*p2*w3-15*s2*p3*w3+90*s*p4*w3
  -50*p5*w3+36*s4*w4+20*s3*p*w4+27*s2*p2*w4-78*s*p3*w4
  +14*p4*w4-24*s5*p*w+60*s4*p2*w-78*s2*p4*w+24*s*p5*w
  +18*p6*w-24*s5*w2+20*s4*p*w2-36*s3*p2*w2+57*s2*p3*w2
  -100*s*p4*w2+60*p5*w2-80*s4*w3+80*s3*p*w3+114*s2*p2*w3
  +43*s*p3*w3-118*p4*w3-36*s3*w4-216*s2*p*w4+6*s*p2*w4
  +96*p3*w4+8*s5*p-16*s4*p2-60*s3*p3+158*s2*p4
  -112*s*p5+18*p6+8*s5*w+36*s4*p*w-4*s3*p2*w
  -250*s2*p3*w+219*s*p4*w+14*p5*w+52*s4*w2-60*s3*p*w2
  +114*s2*p2*w2+s*p3*w2+36*s3*w3+136*s2*p*w3-329*s*p2*w3
  +36*p3*w3-14*s2*w4+338*s*p*w4-32*p2*w4-28*s4*p
  +80*s3*p2+53*s*p4-100*p5-8*s4*w-50*s3*p*w+21*s2*p2*w
  +s*p3*w+100*p4*w+6*s3*w2-72*s2*p*w2+81*s*p2*w2
  -120*p3*w2+102*s2*w3-201*s*p*w3+100*p2*w3+3*s*w4
  -100*p*w4+10*s3*p-6*s2*p2-129*s*p3-32*p4-6*s3*w
  -51*s2*p*w+123*s*p2*w+36*p3*w-51*s2*w2-10*s*p*w2
  -101*s*w3+14*p*w3+18*w4+23*s2*p-43*s*p2+96*p3
  +8*s2*w+135*s*p*w-118*p2*w+19*s*w2+60*p*w2+18*w3
  -19*s*p+14*p2-2*s*w-50*p*w+4*p;
poly B=
  16*s4*p*w3-36*s3*p2*w3+24*s2*p3*w3-5*s*p4*w3
  +16*s4*w4-36*s3*p*w4+24*s2*p2*w4-5*s*p3*w4
  -48*s4*p*w2+124*s3*p2*w2-84*s2*p3*w2-3*s*p4*w2
  +10*p5*w2-48*s4*w3+72*s3*p*w3-24*s2*p2*w3
  -36*s*p3*w3+45*p4*w3-52*s3*w4+60*s2*p*w4-33*s*p2*w4
  +35*p3*w4+48*s4*p*w-140*s3*p2*w+36*s2*p3*w
  +180*s*p4*w-125*p5*w+48*s4*w2-24*s2*p2*w2
  -129*s*p3*w2+90*p4*w2+140*s3*w3-84*s2*p*w3
  -93*s*p2*w3+80*p3*w3-24*s2*w4+216*s*p*w4-135*p2*w4
  -16*s4*p+52*s3*p2+24*s2*p3-172*s*p4+115*p5
  -16*s4*w-72*s3*p*w+84*s2*p2*w+386*s*p3*w-420*p4*w
  -124*s3*w2+24*s2*p*w2+80*p3*w2-36*s2*w3
  -386*s*p*w3+330*p2*w3+172*s*w4-285*p*w4+36*s3*p
  -60*s2*p2-216*s*p3+285*p4+36*s3*w+24*s2*p*w
  +93*s*p2*w-330*p3*w+84*s2*w2+129*s*p*w2-80*p2*w2
  -180*s*w3+420*p*w3-115*w4-24*s2*p+33*s*p2+135*p3
  -24*s2*w+36*s*p*w-80*p2*w+3*s*w2-90*p*w2+125*w3
  +5*s*p-35*p2+5*s*w-45*p*w-10*w2;
poly H=
  p*(s2-4*p)*(p-1)*(1-s+p)*(1+s+p)*(4-2*s+p)
  *(1-2*s+4*p)*w*(w2-1)*(w2-s*w+p)
  *(1-s*w+p*w2)*(5*p-4*s+5);
ideal Isupport=Q,A,B,t*H-1;
ideal Gsupport=std(Isupport);
if (reduce((p+w)^2,Gsupport)!=0)
{
  print("SUPPORT_P_PLUS_W_FAIL");
  exit(1);
}
if (reduce((5*s+4*w-4)^2,Gsupport)!=0)
{
  print("SUPPORT_LINEAR_FAIL");
  exit(1);
}
print("SYMMETRIC_SUPPORT_PASS");
print("BALANCED_SINGULAR_PASS");

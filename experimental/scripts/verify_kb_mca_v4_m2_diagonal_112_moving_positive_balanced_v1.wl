(* Independent Wolfram Engine replay of the canonical moving-moving
   balanced packet.  The y=infinity chart below is a non-load-bearing
   compactification control and is not an assignment globalization. *)

ClearAll["Global`*"];
prime = 2130706433;

(* These are Wolfram Compress strings for exact finite-field inputs.  The
   boundary blob contains the frozen Sage bases and named localizer factors;
   the generic blob contains the original P25 generators and factors.  Wolfram
   independently recomputes each Groebner basis and every membership test. *)
boundaryBlob = "1:";
genericBlob = "1:";

yinfBlob = "1:";
w0Blob = "1:";

{
  alphaZeroGB, alphaZeroFactors,
  d0R0GB, d0R0Factors,
  d0G9GB, d0G9Factors,
  r0DNZGB, r0DNZFactors
} = Uncompress[boundaryBlob];
{genericGenerators, genericFactors} = Uncompress[genericBlob];
{yinfGenerators, yinfFactors} = Uncompress[yinfBlob];
{w0Generators, w0Factors} = Uncompress[w0Blob];

l2Generators = {
  p^5 + 1065353212*p^4*w + 9*p^4 + 1065353203*p^3*w +
    16*p^3 + 1065353203*p^2*w + 9*p^2 + 1065353212*p*w + p,
  w^2 - p,
  s - 852282574*p - 852282574
};
l2Factors = {
  p + 1, p, s^2 - 4*p, p - 1, -s + p + 1, s + p + 1,
  -2*s + p + 4, -2*s + 4*p + 1, w, w^2 - 1,
  -s*w + w^2 + p, p*w^2 - s*w + 1, -4*s + 5*p + 5,
  -2*s*w + p*w + 2*s - 4*p + 4*w - 1
};
l2Eliminant =
  p^10 + 532676606*p^9 + 1065353208*p^8 - 532676606*p^7 +
  15*p^6 - 532676606*p^5 + 1065353208*p^4 +
  532676606*p^3 + p^2;

reduce[poly_, basis_, vars_] :=
  Last[PolynomialReduce[
    Expand[poly], basis, vars,
    MonomialOrder -> DegreeReverseLexicographic,
    Modulus -> prime
  ]];

chart[name_, generators_, factors_, vars_, expectedSize_, nilPower_] :=
 Module[{basis, h, remainder1, remainderN, ok},
  basis = TimeConstrained[
    GroebnerBasis[
      generators, vars,
      MonomialOrder -> DegreeReverseLexicographic,
      Modulus -> prime
    ],
    240, $Aborted
  ];
  h = Expand[Times @@ factors];
  remainder1 = If[
    basis === $Aborted, $Aborted,
    TimeConstrained[reduce[h, basis, vars], 240, $Aborted]
  ];
  remainderN = If[
    basis === $Aborted || remainder1 === $Aborted, $Aborted,
    If[
      nilPower == 1,
      remainder1,
      TimeConstrained[reduce[h^nilPower, basis, vars], 240, $Aborted]
    ]
  ];
  ok =
    basis =!= $Aborted &&
    remainder1 =!= $Aborted &&
    remainderN =!= $Aborted &&
    Length[basis] == expectedSize &&
    If[
      nilPower == 1,
      PossibleZeroQ[remainder1],
      Not[PossibleZeroQ[remainder1]] && PossibleZeroQ[remainderN]
    ];
  WriteLine[
    $Output,
    name <>
      " basis=" <> ToString[If[basis === $Aborted, -1, Length[basis]]] <>
      " HNonzero=" <> ToString[
        remainder1 =!= $Aborted && Not[PossibleZeroQ[remainder1]]
      ] <>
      " HPowerZero=" <> ToString[
        remainderN =!= $Aborted && PossibleZeroQ[remainderN]
      ] <>
      " nilPower=" <> ToString[nilPower] <>
      " ok=" <> ToString[ok]
  ];
  {ok, basis}
 ];

boundaryChart[
  name_, generators_, factors_, vars_, expectedSize_, nilPower_
] :=
 Module[{basis, h, remainders, rabinowitsch, lowerNonzero, ok},
  basis = TimeConstrained[
    GroebnerBasis[
      generators, vars,
      MonomialOrder -> DegreeReverseLexicographic,
      Modulus -> prime
    ],
    240, $Aborted
  ];
  h = Expand[Times @@ factors];
  remainders = If[
    basis === $Aborted,
    $Aborted,
    TimeConstrained[
      Table[reduce[h^exponent, basis, vars], {exponent, 1, nilPower}],
      240, $Aborted
    ]
  ];
  rabinowitsch = If[
    basis === $Aborted,
    $Aborted,
    TimeConstrained[
      GroebnerBasis[
        Join[generators, {t*h - 1}], Append[vars, t],
        MonomialOrder -> DegreeReverseLexicographic,
        Modulus -> prime
      ],
      240, $Aborted
    ]
  ];
  lowerNonzero =
    remainders =!= $Aborted &&
    And @@ (Not[PossibleZeroQ[#]] & /@ Most[remainders]);
  ok =
    basis =!= $Aborted &&
    remainders =!= $Aborted &&
    rabinowitsch =!= $Aborted &&
    Length[basis] == expectedSize &&
    lowerNonzero &&
    PossibleZeroQ[Last[remainders]] &&
    rabinowitsch === {1};
  WriteLine[
    $Output,
    name <>
      " basis=" <> ToString[If[basis === $Aborted, -1, Length[basis]]] <>
      " lowerPowersNonzero=" <> ToString[lowerNonzero] <>
      " HPowerZero=" <> ToString[
        remainders =!= $Aborted && PossibleZeroQ[Last[remainders]]
      ] <>
      " nilPower=" <> ToString[nilPower] <>
      " rabinowitschUnit=" <> ToString[rabinowitsch === {1}] <>
      " ok=" <> ToString[ok]
  ];
  ok
 ];

alphaResult = chart[
  "F5_ALPHA_ZERO", alphaZeroGB, alphaZeroFactors,
  {y, s, p, w}, 24, 1
];
l2Result = chart[
  "L2_P46", l2Generators, l2Factors,
  {s, p, w}, 3, 1
];
d0r0Result = chart[
  "F5_D0_R0", d0R0GB, d0R0Factors,
  {s, p, w}, 4, 1
];
d0g9Result = chart[
  "F5_D0_G9", d0G9GB, d0G9Factors,
  {s, p, w}, 9, 1
];
r0dnzResult = chart[
  "F5_R0_DNZ", r0DNZGB, r0DNZFactors,
  {s, p, w}, 2, 1
];
genericResult = chart[
  "F5_GENERIC_P25", genericGenerators, genericFactors,
  {s, p, w}, 35, 2
];
yinfResult = boundaryChart[
  "PROJECTIVE_Y_INFINITY_CONTROL", yinfGenerators, yinfFactors,
  {s, p, w}, 23, 2
];
w0Result = boundaryChart[
  "FINITE_Y_W_ZERO", w0Generators, w0Factors,
  {y, s, p}, 24, 3
];

expectedEliminant =
  p^2 (p + 1)^4 (p - 1)^2 (p - 4) (p - 1/4);
eliminantOK = PossibleZeroQ[
  PolynomialMod[Expand[l2Eliminant - expectedEliminant], prime]
];
factorization = Factor[l2Eliminant, Modulus -> prime];
WriteLine[
  $Output,
  "L2 eliminantFactorization=" <> ToString[factorization, InputForm] <>
    " ok=" <> ToString[eliminantOK]
];

allOK = And[
  alphaResult[[1]],
  l2Result[[1]],
  d0r0Result[[1]],
  d0g9Result[[1]],
  r0dnzResult[[1]],
  genericResult[[1]],
  yinfResult,
  w0Result,
  eliminantOK
];
WriteLine[$Output, If[allOK, "MOVING_POSITIVE_BALANCED_WOLFRAM_PASS", "FAIL"]];
Exit[If[allOK, 0, 1]];

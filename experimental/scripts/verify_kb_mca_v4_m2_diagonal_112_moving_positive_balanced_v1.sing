// Independent deployed-field replay for the canonical packet.  The
// y=infinity block is a non-load-bearing compactification control.
//
// Sage derives these three basis elements from the source reconstruction and
// P46.  This script starts from that frozen deployed-field basis, checks the
// named localizer directly, and verifies the exact eliminant factorization.
// No saturation and no serialized Groebner basis are used.

option(redSB);
ring r=2130706433,(s,p,w),dp;

poly g1 =
  p^5 + 1065353212*p^4*w + 9*p^4
  + 1065353203*p^3*w + 16*p^3
  + 1065353203*p^2*w + 9*p^2
  + 1065353212*p*w + p;
poly g2 = w^2-p;
poly g3 = s-852282574*p-852282574;

ideal I=g1,g2,g3;
ideal G=std(I);
if (size(G)!=3)
{
  print("L2_P46_BASIS_SIZE_FAIL");
  exit(1);
}

poly H =
  (p+1)*p*(s^2-4*p)*(p-1)*(-s+p+1)*(s+p+1)
  *(-2*s+p+4)*(-2*s+4*p+1)*w*(w^2-1)
  *(-s*w+w^2+p)*(p*w^2-s*w+1)
  *(-4*s+5*p+5)
  *(-2*s*w+p*w+2*s-4*p+4*w-1);
if (reduce(H,G)!=0)
{
  print("L2_P46_LOCALIZER_FAIL");
  exit(1);
}

poly eliminant =
  p^10 + 532676606*p^9 + 1065353208*p^8
  - 532676606*p^7 + 15*p^6 - 532676606*p^5
  + 1065353208*p^4 + 532676606*p^3 + p^2;
if (reduce(eliminant,G)!=0)
{
  print("L2_P46_ELIMINANT_MEMBERSHIP_FAIL");
  exit(1);
}

poly expected =
  p^2*(p+1)^4*(p-1)^2*(p-4)*(p-(1/4));
if (eliminant-expected!=0)
{
  print("L2_P46_ELIMINANT_FACTORIZATION_FAIL");
  exit(1);
}

print("L2_P46_BASIS_SIZE=3");
print("L2_P46_LOCALIZER_REMAINDER=0");
print("L2_P46_ELIMINANT_FACTORIZATION=p2(p+1)4(p-1)2(p-4)(p-1/4)");
print("MOVING_POSITIVE_BALANCED_SINGULAR_PASS");


// Non-load-bearing projective y=infinity control; w is not inverted.
ring r_yinf=2130706433,(s,p,w),dp;
ideal I_yinf=4*s^4*p^2*w^2 - 8*s^2*p^4*w^2 + 4*p^6*w^2 - 24*s^4*p^2*w + 40*s^3*p^3*w + 16*s^2*p^4*w - 40*s*p^5*w + 8*p^6*w - 24*s^4*p*w^2 + 100*s^3*p^2*w^2 - 164*s^2*p^3*w^2 + 100*s*p^4*w^2 - 17*p^5*w^2 + 36*s^4*p^2 - 120*s^3*p^3 + 124*s^2*p^4 - 40*s*p^5 + 4*p^6 - 16*s^4*p*w + 120*s^3*p^2*w - 68*s^2*p^3*w - 120*s*p^4*w + 66*p^5*w + 4*s^4*w^2 + 80*s^3*p*w^2 - 271*s^2*p^2*w^2 + 280*s*p^3*w^2 - 104*p^4*w^2 + 8*s^4*p - 140*s^3*p^2 + 232*s^2*p^3 - 60*s*p^4 - 17*p^5 + 8*s^4*w + 40*s^3*p*w - 118*s^2*p^2*w - 160*s*p^3*w + 192*p^4*w - 20*s^3*w^2 - 82*s^2*p*w^2 + 240*s*p^2*w^2 - 166*p^3*w^2 + 4*s^4 - 40*s^3*p + 125*s^2*p^2 + 40*s*p^3 - 104*p^4 - 40*s^3*w + 32*s^2*p*w - 160*s*p^2*w + 268*p^3*w + 33*s^2*w^2 + 40*s*p*w^2 - 104*p^2*w^2 - 20*s^3 + 50*s^2*p + 80*s*p^2 - 166*p^3 + 66*s^2*w - 120*s*p*w + 192*p^2*w - 20*s*w^2 - 17*p*w^2 + 33*s^2 - 104*p^2 - 40*s*w + 66*p*w + 4*w^2 - 20*s - 17*p + 8*w + 4,-20*s^2*p^3*w^2 + 41*s*p^4*w^2 - 20*p^5*w^2 + 32*s^3*p^2*w - 80*s^2*p^3*w + 50*s*p^4*w + 32*s^3*p*w^2 - 140*s^2*p^2*w^2 + 214*s*p^3*w^2 - 100*p^4*w^2 - 32*s^3*p^2 + 100*s^2*p^3 - 91*s*p^4 + 20*p^5 - 80*s^2*p^2*w + 100*s*p^3*w + 32*s^3*w^2 - 220*s^2*p*w^2 + 396*s*p^2*w^2 - 200*p^3*w^2 - 32*s^3*p + 220*s^2*p^2 - 314*s*p^3 + 100*p^4 - 32*s^3*w + 80*s^2*p*w - 100*s^2*w^2 + 314*s*p*w^2 - 200*p^2*w^2 + 140*s^2*p - 396*s*p^2 + 200*p^3 + 80*s^2*w - 100*s*p*w + 91*s*w^2 - 100*p*w^2 + 20*s^2 - 214*s*p + 200*p^2 - 50*s*w - 20*w^2 - 41*s + 100*p + 20,-144*s^7*p^2*w^4 + 592*s^6*p^3*w^4 - 916*s^5*p^4*w^4 + 628*s^4*p^5*w^4 - 164*s^3*p^6*w^4 + 128*s^2*p^7*w^4 - 236*s*p^8*w^4 + 108*p^9*w^4 + 384*s^7*p^2*w^3 - 1424*s^6*p^3*w^3 + 1720*s^5*p^4*w^3 - 744*s^4*p^5*w^3 + 448*s^3*p^6*w^3 - 704*s^2*p^7*w^3 + 360*s*p^8*w^3 - 48*p^9*w^3 + 96*s^7*p*w^4 + 368*s^6*p^2*w^4 - 1896*s^5*p^3*w^4 + 2644*s^4*p^4*w^4 - 988*s^3*p^5*w^4 - 1548*s^2*p^6*w^4 + 1813*s*p^7*w^4 - 495*p^8*w^4 - 352*s^7*p^2*w^2 + 912*s^6*p^3*w^2 + 812*s^5*p^4*w^2 - 4608*s^4*p^5*w^2 + 4944*s^3*p^6*w^2 - 1936*s^2*p^7*w^2 + 436*s*p^8*w^2 - 192*p^9*w^2 